<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- v1.3.0: светлый родитель (isLightTheme=true) — WebView отдаёт prefers-color-scheme по системной теме -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:statusBarColor">#F1F0EC</item>
        <item name="android:navigationBarColor">#F1F0EC</item>
        <item name="android:windowBackground">#F1F0EC</item>
        <item name="android:colorAccent">#E95C26</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
